{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "6.2",
  "title": "Quantifier Scope Tests",
  "tests": [
    {
      "id": 1,
      "expression": ["And", ["Forall", ["x"], ["Or", "x", "p"]], ["Forall", ["x"], ["Or", "x", "q"]]],
      "variable": "x",
      "expected_result": ["Forall", ["x"], ["And", ["Or", "x", "p"], ["Or", "x", "q"]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 2,
      "expression": ["Or", ["Exists", ["x"], ["And", "x", "p"]], ["Exists", ["x"], ["And", "x", "q"]]],
      "variable": "x",
      "expected_result": ["Exists", ["x"], ["Or", ["And", "x", "p"], ["And", "x", "q"]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 3,
      "expression": ["Forall", ["x"], ["Or", "p", "q"]],
      "variable": "x",
      "expected_result": ["Or", "p", "q"],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 4,
      "expression": ["Exists", ["x"], ["And", "p", "q"]],
      "variable": "x",
      "expected_result": ["And", "p", "q"],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 5,
      "expression": ["Exists", ["x"], ["And", ["Or", "x", "p"], "q"]],
      "variable": "x",
      "expected_result": ["And", ["Exists", ["x"], ["Or", "x", "p"]], "q"],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 6,
      "expression": ["Forall", ["x"], ["Or", ["And", "x", "p"], "q"]],
      "variable": "x",
      "expected_result": ["Or", ["Forall", ["x"], ["And", "x", "p"]], "q"],
      "num_steps": 1,
      "grade": "A"
    }
  ]
}
