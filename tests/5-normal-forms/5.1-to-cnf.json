      "expected_result": ["And", ["Or", "p", "q"], ["Or", "p", "r"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 2,
      "expression": ["Or", ["And", "q", "r"], "p"],
      "variable": "p",
      "expected_result": ["And", ["Or", "q", "p"], ["Or", "r", "p"]],
      "num_steps": 1,
      "grade": "A"
    }
  ]
}
